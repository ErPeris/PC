  (text "Dal microcontrollore:\n1 = GND\n2 = PWM1  3 = PWM2  4 = PWM3" (at 17.78 87.63 0)
    (effects
      (font (size 1.27 1.27)) (justify left bottom)) (uuid ab402bc7-b591-45c5-9114-c9871173d537))
  (text "VREF = 5V x 10k / (22k + 10k)\n       = 1.56 V (soglia)" (at 25.4 147.32 0)
    (effects
      (font (size 1.27 1.27)) (justify left bottom)) (uuid 7e3df621-4175-4e45-b7c5-a8fc278a3655))
  (text "Servo: 1 = GND, 2 = +5V, 3 = PWM 5V" (at 152.4 87.63 0)
    (effects
